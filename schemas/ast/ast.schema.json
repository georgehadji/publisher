{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher.internal/schemas/ast/1",
  "title": "Book AST",
  "description": "Canonical semantic book model — derived from DOCX, consumed by all renderers.",
  "type": "object",
  "properties": {
    "schema": { "$ref": "#/$defs/schemaRef" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "frontMatter": {
      "type": "array",
      "items": { "$ref": "#/$defs/frontMatterNode" },
      "description": "Half-title, title, copyright, dedication, epigraph, TOC, foreword, preface, acknowledgments, prologue"
    },
    "body": {
      "type": "array",
      "items": { "$ref": "#/$defs/bodyNode" },
      "description": "Parts and chapters"
    },
    "backMatter": {
      "type": "array",
      "items": { "$ref": "#/$defs/backMatterNode" },
      "description": "Epilogue, afterword, appendix, notes, bibliography, index, about-the-author, also-by, colophon"
    },
    "integrityHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256(normalize(concat(all text nodes))) — text-integrity invariant"
    },
    "sourceRef": {
      "$ref": "#/$defs/sourceRef",
      "description": "Provenance of this AST (manuscript version + inference version)"
    }
  },
  "required": ["schema", "body", "integrityHash", "sourceRef"],
  "additionalProperties": false,
  "$defs": {
    "schemaRef": {
      "type": "string",
      "enum": ["ast/1"],
      "description": "Schema version — bump on any breaking change"
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "manuscriptId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "manuscriptVersion": { "type": "integer", "minimum": 1 },
        "inferenceVersion": { "type": "integer", "minimum": 1 },
        "inferenceModelId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["manuscriptId", "inferenceVersion"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 1024 },
        "subtitle": { "type": "string", "maxLength": 1024 },
        "contributors": {
          "type": "array",
          "items": { "$ref": "#/$defs/contributor" },
          "maxItems": 200
        },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "isbn": { "type": "string", "pattern": "^(978|979)[0-9]{10}$" },
        "series": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 256 },
            "volume": { "type": "integer", "minimum": 1 }
          },
          "required": ["name"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contributor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["author", "editor", "translator", "illustrator", "forewordBy", "introductionBy"]
        },
        "givenName": { "type": "string", "maxLength": 256 },
        "familyName": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 256 }
      },
      "required": ["role", "displayName"],
      "additionalProperties": false
    },
    "sourceRefLink": {
      "type": "object",
      "properties": {
        "docxId": { "type": "string", "maxLength": 128 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["docxId"],
      "additionalProperties": false
    },
    "confidence": {
      "description": "How sure the producer was that this node is the structural type it was given, on the rules engine's scale (below 0.8 escalates for review). Carried only by nodes whose type a heuristic DECIDED -- chapters and front/back-matter sections. ABSENT means not measured, which is not the same as 1.0: a reader must never default it to confident.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bodyNode": {
      "$comment": "A union discriminated by `type`, not a oneOf. The branches are disjoint by their `type` enums and every branch is a closed object requiring `type`, so this accepts exactly what oneOf over the same branches did. But jsonschema evaluates EVERY oneOf branch in full at every depth, which made validation exponential in nesting: a table in a table cell did not finish in minutes. Here each `if` reads only `type`, and one `then` descends. Keep `properties.type.enum` equal to the union of the branches' types; services/ingest/tests/test_word_corpus.py checks it.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["part", "chapter"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "part" } } }, "then": { "$ref": "#/$defs/part" } },
        { "if": { "properties": { "type": { "const": "chapter" } } }, "then": { "$ref": "#/$defs/chapter" } }
      ]
    },
    "part": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["part"] },
        "attrs": {
          "type": "object",
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "title": { "type": "string", "maxLength": 512 },
            "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 }
          },
          "required": ["title", "id"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/chapter" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "attrs", "content"],
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["chapter"] },
        "attrs": {
          "type": "object",
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "title": { "type": "string", "maxLength": 512 },
            "startsOn": { "type": "string", "enum": ["recto", "verso", "any"] },
            "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 }
          },
          "required": ["number", "id"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockNode" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "required": ["type", "attrs", "content"],
      "additionalProperties": false
    },
    "blockNode": {
      "$comment": "Discriminated by `type`; see bodyNode.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["paragraph", "heading", "blockquote", "verse", "list", "table", "figure", "footnote", "epigraph", "sceneBreak", "dialogue", "sidebar", "code", "equation", "pageBreak"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "paragraph" } } }, "then": { "$ref": "#/$defs/paragraph" } },
        { "if": { "properties": { "type": { "const": "heading" } } }, "then": { "$ref": "#/$defs/heading" } },
        { "if": { "properties": { "type": { "const": "blockquote" } } }, "then": { "$ref": "#/$defs/blockquote" } },
        { "if": { "properties": { "type": { "const": "verse" } } }, "then": { "$ref": "#/$defs/verse" } },
        { "if": { "properties": { "type": { "const": "list" } } }, "then": { "$ref": "#/$defs/list" } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "$ref": "#/$defs/table" } },
        { "if": { "properties": { "type": { "const": "figure" } } }, "then": { "$ref": "#/$defs/figure" } },
        { "if": { "properties": { "type": { "const": "footnote" } } }, "then": { "$ref": "#/$defs/footnote" } },
        { "if": { "properties": { "type": { "const": "epigraph" } } }, "then": { "$ref": "#/$defs/epigraph" } },
        { "if": { "properties": { "type": { "const": "sceneBreak" } } }, "then": { "$ref": "#/$defs/sceneBreak" } },
        { "if": { "properties": { "type": { "const": "dialogue" } } }, "then": { "$ref": "#/$defs/dialogue" } },
        { "if": { "properties": { "type": { "const": "sidebar" } } }, "then": { "$ref": "#/$defs/sidebar" } },
        { "if": { "properties": { "type": { "const": "code" } } }, "then": { "$ref": "#/$defs/code" } },
        { "if": { "properties": { "type": { "const": "equation" } } }, "then": { "$ref": "#/$defs/equation" } },
        { "if": { "properties": { "type": { "const": "pageBreak" } } }, "then": { "$ref": "#/$defs/pageBreak" } }
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["paragraph"] },
        "attrs": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["normal", "chapter-opening", "first-paragraph", "last-paragraph", "continued", "attribution", "source"]
            },
            "indent": { "type": "number", "minimum": 0 },
            "alignment": { "type": "string", "enum": ["left", "center", "right", "justify"] },
            "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "heading": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["heading"] },
        "attrs": {
          "type": "object",
          "properties": {
            "level": { "type": "integer", "minimum": 1, "maximum": 6 },
            "role": { "type": "string", "enum": ["section", "subsection", "subsubsection", "running-head"] }
          },
          "required": ["level"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "attrs", "content"],
      "additionalProperties": false
    },
    "blockquote": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["blockquote"] },
        "attrs": {
          "type": "object",
          "properties": {
            "role": { "type": "string", "enum": ["pull-quote", "extract", "letter", "prayer"] },
            "source": { "type": "string", "maxLength": 256 }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/paragraph" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "verse": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["verse"] },
        "attrs": {
          "type": "object",
          "properties": {
            "role": { "type": "string", "enum": ["poem", "song-lyrics"] }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["line"] },
              "content": {
                "type": "array",
                "items": { "$ref": "#/$defs/inlineNode" },
                "minItems": 1
              }
            },
            "required": ["type", "content"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["list"] },
        "attrs": {
          "type": "object",
          "properties": {
            "listType": { "type": "string", "enum": ["ordered", "unordered"] },
            "start": { "type": "integer", "minimum": 1 },
            "tight": { "type": "boolean" }
          },
          "required": ["listType"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["list-item"] },
              "content": {
                "type": "array",
                "items": { "$ref": "#/$defs/blockNode" },
                "minItems": 1
              },
              "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
            },
            "required": ["type", "content"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "attrs", "content"],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["table"] },
        "attrs": {
          "type": "object",
          "properties": {
            "caption": { "type": "string", "maxLength": 512 },
            "colgroup": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "width": { "type": "string" },
                  "align": { "type": "string", "enum": ["left", "center", "right"] }
                },
                "additionalProperties": false
              },
              "maxItems": 100
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableRow" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "tableRow": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["table-row"] },
        "attrs": {
          "type": "object",
          "properties": {
            "header": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableCell" },
          "minItems": 1
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "tableCell": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["table-cell"] },
        "attrs": {
          "type": "object",
          "properties": {
            "colspan": { "type": "integer", "minimum": 1, "maximum": 20 },
            "rowspan": { "type": "integer", "minimum": 1, "maximum": 20 },
            "align": { "type": "string", "enum": ["left", "center", "right"] }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockNode" },
          "minItems": 1
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "figure": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["figure"] },
        "attrs": {
          "type": "object",
          "properties": {
            "mediaRef": { "$ref": "#/$defs/mediaRef" },
            "caption": { "type": "string", "maxLength": 1024 },
            "altText": { "type": "string", "maxLength": 2048 },
            "width": { "type": "string" },
            "placement": { "type": "string", "enum": ["inline", "float-left", "float-right", "full-page"] }
          },
          "required": ["mediaRef"],
          "additionalProperties": false
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "attrs"],
      "additionalProperties": false
    },
    "mediaRef": {
      "type": "object",
      "properties": {
        "hash": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "enum": ["image/png", "image/jpeg", "image/svg+xml", "image/tiff"] },
        "originalName": { "type": "string", "maxLength": 256 }
      },
      "required": ["hash", "mediaType"],
      "additionalProperties": false
    },
    "footnote": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["footnote"] },
        "attrs": {
          "type": "object",
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "symbol": { "type": "string", "maxLength": 4 }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "epigraph": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["epigraph"] },
        "attrs": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "maxLength": 256 }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/paragraph" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "sceneBreak": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["sceneBreak"] },
        "attrs": {
          "type": "object",
          "properties": {
            "ornament": { "type": "string", "enum": ["dinkus", "asterism", "fleuron", "blank-line", "section-symbol"] }
          },
          "additionalProperties": false
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["dialogue"] },
        "attrs": {
          "type": "object",
          "properties": {
            "speaker": { "type": "string", "maxLength": 128 }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/paragraph" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["sidebar"] },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockNode" },
          "minItems": 1
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["code"] },
        "attrs": {
          "type": "object",
          "properties": {
            "language": { "type": "string", "maxLength": 32 },
            "numbered": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "content": { "type": "string" },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "equation": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["equation"] },
        "attrs": {
          "type": "object",
          "properties": {
            "numbered": { "type": "boolean" },
            "label": { "type": "string", "maxLength": 64 }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "string",
          "description": "LaTeX or MathML expression"
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "pageBreak": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["pageBreak"] },
        "attrs": {
          "type": "object",
          "properties": {
            "breakType": { "type": "string", "enum": ["page", "column", "section", "recto", "verso"] }
          },
          "additionalProperties": false
        },
        "sourceRef": { "$ref": "#/$defs/sourceRefLink" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "inlineNode": {
      "$comment": "Discriminated by `type`; see bodyNode.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["text", "emphasis", "strong", "link", "superscript", "subscript", "smallCaps", "codeInline", "hardBreak", "indexEntry", "crossReference"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "$ref": "#/$defs/text" } },
        { "if": { "properties": { "type": { "const": "emphasis" } } }, "then": { "$ref": "#/$defs/emphasis" } },
        { "if": { "properties": { "type": { "const": "strong" } } }, "then": { "$ref": "#/$defs/strong" } },
        { "if": { "properties": { "type": { "const": "link" } } }, "then": { "$ref": "#/$defs/link" } },
        { "if": { "properties": { "type": { "const": "superscript" } } }, "then": { "$ref": "#/$defs/superscript" } },
        { "if": { "properties": { "type": { "const": "subscript" } } }, "then": { "$ref": "#/$defs/subscript" } },
        { "if": { "properties": { "type": { "const": "smallCaps" } } }, "then": { "$ref": "#/$defs/smallCaps" } },
        { "if": { "properties": { "type": { "const": "codeInline" } } }, "then": { "$ref": "#/$defs/codeInline" } },
        { "if": { "properties": { "type": { "const": "hardBreak" } } }, "then": { "$ref": "#/$defs/hardBreak" } },
        { "if": { "properties": { "type": { "const": "indexEntry" } } }, "then": { "$ref": "#/$defs/indexEntry" } },
        { "if": { "properties": { "type": { "const": "crossReference" } } }, "then": { "$ref": "#/$defs/crossReference" } }
      ]
    },
    "text": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["text"] },
        "text": { "type": "string" },
        "marks": {
          "type": "array",
          "items": { "$ref": "#/$defs/mark" },
          "maxItems": 10
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "mark": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["emphasis", "strong", "smallCaps", "underline", "strikethrough", "superscript", "subscript", "code", "link"] },
        "attrs": {
          "type": "object",
          "properties": {
            "href": { "type": "string", "format": "uri" },
            "title": { "type": "string", "maxLength": 256 }
          },
          "additionalProperties": false
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "emphasis": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["emphasis"] },
        "attrs": {
          "type": "object",
          "properties": {
            "role": { "type": "string", "enum": ["emphasis", "title-of-work", "foreign", "thought"] }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "strong": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["strong"] },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["link"] },
        "attrs": {
          "type": "object",
          "properties": {
            "href": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
            "title": { "type": "string", "maxLength": 256 },
            "target": { "type": "string", "enum": ["_self", "_blank", "_top"] }
          },
          "required": ["href"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        }
      },
      "required": ["type", "attrs", "content"],
      "additionalProperties": false
    },
    "superscript": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["superscript"] },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "subscript": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["subscript"] },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "smallCaps": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["smallCaps"] },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "codeInline": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["codeInline"] },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "hardBreak": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["hardBreak"] }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "indexEntry": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["indexEntry"] },
        "attrs": {
          "type": "object",
          "properties": {
            "term": { "type": "string", "maxLength": 128 },
            "subterm": { "type": "string", "maxLength": 128 },
            "see": { "type": "string", "maxLength": 128 },
            "seeAlso": { "type": "string", "maxLength": 128 }
          },
          "required": ["term"],
          "additionalProperties": false
        }
      },
      "required": ["type", "attrs"],
      "additionalProperties": false
    },
    "crossReference": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["crossReference"] },
        "attrs": {
          "type": "object",
          "properties": {
            "target": { "type": "string", "maxLength": 64 },
            "display": { "type": "string", "enum": ["number", "title", "page", "number-and-title"] }
          },
          "required": ["target"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/inlineNode" },
          "minItems": 1
        }
      },
      "required": ["type", "attrs", "content"],
      "additionalProperties": false
    },
    "frontMatterNode": {
      "$comment": "Discriminated by `type`; see bodyNode.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["paragraph", "heading", "blockquote", "verse", "list", "table", "figure", "footnote", "epigraph", "sceneBreak", "dialogue", "sidebar", "code", "equation", "pageBreak", "halfTitle", "titlePage", "copyrightPage", "dedication", "toc", "foreword", "preface", "acknowledgments", "prologue"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["paragraph", "heading", "blockquote", "verse", "list", "table", "figure", "footnote", "epigraph", "sceneBreak", "dialogue", "sidebar", "code", "equation", "pageBreak"] } } }, "then": { "$ref": "#/$defs/blockNode" } },
        { "if": { "properties": { "type": { "enum": ["halfTitle", "titlePage", "copyrightPage", "dedication", "toc", "foreword", "preface", "acknowledgments", "prologue"] } } }, "then": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["halfTitle", "titlePage", "copyrightPage", "dedication", "toc", "foreword", "preface", "acknowledgments", "prologue"] },
            "content": {
              "type": "array",
              "items": { "$ref": "#/$defs/blockNode" },
              "minItems": 1
            },
            "confidence": { "$ref": "#/$defs/confidence" }
          },
          "required": ["type", "content"],
          "additionalProperties": false
        } }
      ]
    },
    "backMatterNode": {
      "$comment": "Discriminated by `type`; see bodyNode.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["paragraph", "heading", "blockquote", "verse", "list", "table", "figure", "footnote", "epigraph", "sceneBreak", "dialogue", "sidebar", "code", "equation", "pageBreak", "epilogue", "afterword", "appendix", "notes", "bibliography", "index", "aboutTheAuthor", "alsoBy", "colophon"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["paragraph", "heading", "blockquote", "verse", "list", "table", "figure", "footnote", "epigraph", "sceneBreak", "dialogue", "sidebar", "code", "equation", "pageBreak"] } } }, "then": { "$ref": "#/$defs/blockNode" } },
        { "if": { "properties": { "type": { "enum": ["epilogue", "afterword", "appendix", "notes", "bibliography", "index", "aboutTheAuthor", "alsoBy", "colophon"] } } }, "then": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["epilogue", "afterword", "appendix", "notes", "bibliography", "index", "aboutTheAuthor", "alsoBy", "colophon"] },
            "content": {
              "type": "array",
              "items": { "$ref": "#/$defs/blockNode" },
              "minItems": 1
            },
            "confidence": { "$ref": "#/$defs/confidence" }
          },
          "required": ["type", "content"],
          "additionalProperties": false
        } }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hex-encoded SHA-256 hash"
    }
  }
}
