{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher.internal/schemas/ast/1",
  "title": "Book AST",
  "description": "Canonical semantic book model — derived from DOCX, consumed by all renderers.",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "#/$defs/schemaRef"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "frontMatter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frontMatterNode"
      },
      "description": "Half-title, title, copyright, dedication, epigraph, TOC, foreword, preface, acknowledgments, prologue"
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bodyNode"
      },
      "description": "Parts and chapters"
    },
    "backMatter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/backMatterNode"
      },
      "description": "Epilogue, afterword, appendix, notes, bibliography, index, about-the-author, also-by, colophon"
    },
    "integrityHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256(normalize(concat(all text nodes))) — text-integrity invariant"
    },
    "sourceRef": {
      "$ref": "#/$defs/sourceRef",
      "description": "Provenance of this AST (manuscript version + inference version)"
    }
  },
  "required": [
    "schema",
    "body",
    "integrityHash",
    "sourceRef"
  ],
  "additionalProperties": false,
  "$defs": {
    "schemaRef": {
      "type": "string",
      "enum": [
        "ast/1"
      ],
      "description": "Schema version — bump on any breaking change"
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "manuscriptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "manuscriptVersion": {
          "type": "integer",
          "minimum": 1
        },
        "inferenceVersion": {
          "type": "integer",
          "minimum": 1
        },
        "inferenceModelId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "manuscriptId",
        "inferenceVersion"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "subtitle": {
          "type": "string",
          "maxLength": 1024
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contributor"
          },
          "maxItems": 200
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "isbn": {
          "type": "string",
          "pattern": "^(978|979)[0-9]{10}$"
        },
        "series": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 256
            },
            "volume": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contributor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "author",
            "editor",
            "translator",
            "illustrator",
            "forewordBy",
            "introductionBy"
          ]
        },
        "givenName": {
          "type": "string",
          "maxLength": 256
        },
        "familyName": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "role",
        "displayName"
      ],
      "additionalProperties": false
    },
    "sourceRefLink": {
      "type": "object",
      "properties": {
        "docxId": {
          "type": "string",
          "maxLength": 128
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "docxId"
      ],
      "additionalProperties": false
    },
    "bodyNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/part"
        },
        {
          "$ref": "#/$defs/chapter"
        }
      ]
    },
    "part": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "part"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "maxLength": 512
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$",
              "maxLength": 64
            }
          },
          "required": [
            "title",
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "chapter"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "maxLength": 512
            },
            "startsOn": {
              "type": "string",
              "enum": [
                "recto",
                "verso",
                "any"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$",
              "maxLength": 64
            }
          },
          "required": [
            "number",
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blockNode"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "blockNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/blockquote"
        },
        {
          "$ref": "#/$defs/verse"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/figure"
        },
        {
          "$ref": "#/$defs/footnote"
        },
        {
          "$ref": "#/$defs/epigraph"
        },
        {
          "$ref": "#/$defs/sceneBreak"
        },
        {
          "$ref": "#/$defs/dialogue"
        },
        {
          "$ref": "#/$defs/sidebar"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/equation"
        },
        {
          "$ref": "#/$defs/pageBreak"
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "paragraph"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "normal",
                "chapter-opening",
                "first-paragraph",
                "last-paragraph",
                "continued",
                "attribution",
                "source"
              ]
            },
            "indent": {
              "type": "number",
              "minimum": 0
            },
            "alignment": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right",
                "justify"
              ]
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inlineNode"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "heading": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "heading"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "role": {
              "type": "string",
              "enum": [
                "section",
                "subsection",
                "subsubsection",
                "running-head"
              ]
            }
          },
          "required": [
            "level"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inlineNode"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "blockquote": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "blockquote"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "pull-quote",
                "extract",
                "letter",
                "prayer"
              ]
            },
            "source": {
              "type": "string",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "verse": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "verse"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "poem",
                "song-lyrics"
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "line"
                ]
              },
              "content": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/inlineNode"
                },
                "minItems": 1
              }
            },
            "required": [
              "type",
              "content"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "list"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "listType": {
              "type": "string",
              "enum": [
                "ordered",
                "unordered"
              ]
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "tight": {
              "type": "boolean"
            }
          },
          "required": [
            "listType"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "list-item"
                ]
              },
              "content": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/blockNode"
                },
                "minItems": 1
              },
              "sourceRef": {
                "$ref": "#/$defs/sourceRefLink"
              }
            },
            "required": [
              "type",
              "content"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "table"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "caption": {
              "type": "string",
              "maxLength": 512
            },
            "colgroup": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "string"
                  },
                  "align": {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 100
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableRow"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "tableRow": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "table-row"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "header": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableCell"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "tableCell": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "table-cell"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "colspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "align": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blockNode"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "figure": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "figure"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "mediaRef": {
              "$ref": "#/$defs/mediaRef"
            },
            "caption": {
              "type": "string",
              "maxLength": 1024
            },
            "altText": {
              "type": "string",
              "maxLength": 2048
            },
            "width": {
              "type": "string"
            },
            "placement": {
              "type": "string",
              "enum": [
                "inline",
                "float-left",
                "float-right",
                "full-page"
              ]
            }
          },
          "required": [
            "mediaRef"
          ],
          "additionalProperties": false
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "mediaRef": {
      "type": "object",
      "properties": {
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/svg+xml",
            "image/tiff"
          ]
        },
        "originalName": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "hash",
        "mediaType"
      ],
      "additionalProperties": false
    },
    "footnote": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "footnote"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "symbol": {
              "type": "string",
              "maxLength": 4
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inlineNode"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "epigraph": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "epigraph"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "sceneBreak": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "sceneBreak"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "ornament": {
              "type": "string",
              "enum": [
                "dinkus",
                "asterism",
                "fleuron",
                "blank-line",
                "section-symbol"
              ]
            }
          },
          "additionalProperties": false
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dialogue"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "speaker": {
              "type": "string",
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "sidebar"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blockNode"
          },
          "minItems": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "maxLength": 32
            },
            "numbered": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "string"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "equation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "equation"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "numbered": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "string",
          "description": "LaTeX or MathML expression"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "pageBreak": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "pageBreak"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "breakType": {
              "type": "string",
              "enum": [
                "page",
                "column",
                "section",
                "recto",
                "verso"
              ]
            }
          },
          "additionalProperties": false
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRefLink"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "inlineNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/emphasis"
        },
        {
          "$ref": "#/$defs/strong"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/superscript"
        },
        {
          "$ref": "#/$defs/subscript"
        },
        {
