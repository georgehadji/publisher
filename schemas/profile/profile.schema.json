{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher.internal/schemas/profile/1",
  "title": "OutputProfile",
  "description": "Vendor-specific output specification — trim, bleed, PDF version, colour space.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "enum": ["profile/1"] },
    "name": { "type": "string", "maxLength": 128 },
    "vendor": { "type": "string", "enum": ["kdp", "ingramspark", "lulu", "barnesnoble", "generic", "greek"] },
    "vendorProfileVersion": { "type": "string", "maxLength": 32 },
    "trimSize": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "minimum": 76, "maximum": 340, "description": "mm" },
        "height": { "type": "number", "minimum": 100, "maximum": 340, "description": "mm" },
        "unit": { "type": "string", "enum": ["mm", "in"], "default": "mm" }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "bleed": {
      "type": "object",
      "properties": {
        "all": { "type": "number", "minimum": 0, "maximum": 25, "description": "mm, every side. The one bleed figure design-compile, finish, cover and preflight all read." }
      },
      "required": ["all"],
      "additionalProperties": false
    },
    "pdfSpec": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "enum": ["1.3", "1.4", "1.5", "1.6", "1.7", "2.0"], "default": "1.7" },
        "standard": { "type": "string", "enum": ["none", "pdfx-1a", "pdfx-3", "pdfx-4", "pdfa-2b"], "default": "pdfx-1a" },
        "colorSpace": { "type": "string", "enum": ["cmyk", "gray", "rgb"], "default": "cmyk" },
        "maxInkCoverage": { "type": "integer", "minimum": 100, "maximum": 400, "default": 300, "description": "Highest total ink (C+M+Y+K, percent) the vendor accepts anywhere on a page; 300 is the common limit for coated offset stock." },
        "minImageDpi": { "type": "integer", "minimum": 72, "maximum": 1200, "default": 300, "description": "Lowest effective resolution a placed image may print at. Not the proof's dpi (proofSpec.dpi)." }
      },
      "required": ["standard", "colorSpace"],
      "additionalProperties": false
    },
    "coverSpec": {
      "type": "object",
      "default": {},
      "properties": {
        "paperType": { "type": "string", "enum": ["matte", "glossy", "premium-matte", "linen", "none"] },
        "ink": { "type": "string", "enum": ["full-color", "black-and-white"], "default": "full-color" },
        "finish": { "type": "string", "enum": ["perfect-bound", "saddle-stitch", "case-bound", "spiral"] },
        "pageThicknessMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "The vendor's stated caliper per page, mm: spine = pages x this. No default: a profile that states none gets a spine from publisher_prepress.geometry.DEFAULT_PAGE_THICKNESS_MM, and the cover stage warns that it is a guess." }
      },
      "additionalProperties": false
    },
    "proofSpec": {
      "type": "object",
      "default": {},
      "properties": {
        "watermark": { "type": "boolean", "default": true },
        "dpi": { "type": "integer", "enum": [72, 150, 300], "default": 150 },
        "sizeBudgetBytes": { "type": "integer", "minimum": 0, "default": 0, "description": "0 = no limit" }
      },
      "additionalProperties": false,
      "description": "Proof PDF spec — O4: if sizeBudgetBytes is set, preflight enforces it as a policy_violation"
    },
    "deliverySpec": {
      "type": "object",
      "properties": {
        "interiorFormat": {
          "type": "array",
          "items": { "type": "string", "enum": ["pdf", "epub", "idml", "onix"] },
          "maxItems": 4
        },
        "coverFormat": {
          "type": "array",
          "items": { "type": "string", "enum": ["pdf", "jpeg"] },
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "minPages": { "type": "integer", "minimum": 1, "description": "Vendor minimum page count" },
    "maxPages": { "type": "integer", "minimum": 1, "description": "Vendor maximum page count" },
    "pageSizeMultiple": { "type": "integer", "minimum": 1, "default": 4, "description": "e.g. 4 for KDP (books are 4-page multiples)" },
    "bindingSpec": {
      "type": "object",
      "properties": {
        "minInsideMarginMm": {
          "type": "array",
          "description": "The vendor's minimum inside (gutter-side) margin by page count, mm, ascending by maxPages. Preflight measures each page's inside margin from the press PDF against the band for its page count; a profile without a table skips the check.",
          "items": {
            "type": "object",
            "properties": {
              "maxPages": { "type": "integer", "minimum": 1 },
              "mm": { "type": "number", "minimum": 0, "maximum": 60 }
            },
            "required": ["maxPages", "mm"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "properties": {
        "maxOrphanPages": { "type": "integer", "minimum": 0, "default": 0, "description": "Pages that may end on a paragraph's stranded first line before preflight fails." }
      },
      "default": {},
      "additionalProperties": false
    },
    "validatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["schema", "name", "vendor", "trimSize", "bleed", "pdfSpec"],
  "additionalProperties": false
}
