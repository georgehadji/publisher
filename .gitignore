# Node
node_modules/
# This is a pnpm workspace (pnpm-workspace.yaml; root scripts use `pnpm -r`).
# An npm/yarn lockfile at the repo ROOT (or in a package pnpm actually
# manages) would pin a second, conflicting dependency graph.
#
# packages/api and packages/web are the exception: despite being listed in
# pnpm-workspace.yaml's `packages/*` glob, both are installed independently
# via plain `npm ci`/`npm install` everywhere that matters -- Dockerfile.api
# (`RUN cd packages/api && npm install`) and .github/workflows/ci.yml's
# `node` and `supply-chain` jobs (`npm ci` in each). Neither has ever
# depended on another workspace package via the `workspace:*` protocol, so
# `pnpm install` at the root has nothing to conflict with (verified: it
# completes cleanly with both lockfiles present). Without a committed
# lockfile, `npm ci` in CI has no lockfile to install from and fails before
# a single test runs -- caught because it's exactly what those CI jobs do
# on a truly clean checkout, which local dev never exercises.
package-lock.json
!packages/api/package-lock.json
!packages/web/package-lock.json
yarn.lock
dist/
*.tsbuildinfo
# Next.js build output (packages/web) -- regenerates from `npm run build`/`dev`.
.next/
next-env.d.ts

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Rust
target/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db


# Build state -- durable CAS blobs + sqlite cache index (PUBLISHER_CAS_ROOT),
# and the test harness's own CAS. Content-addressed build output, not source;
# regenerates on the next build.
.publisher/
.test-cas-cache/
.cas-cache/

# Claude Code tool state, not source. `.claude/skills/` IS tracked (the folder
# maps CLAUDE.md points at), so these are named individually rather than
# ignoring `.claude/` wholesale, which would silently drop the skills.
.claude/claudex/
packages/api/.claude/
packages/web/.claude/

# Authors' manuscripts dropped into corpus/ for a local ingest run. This repo is
# public and a manuscript is not ours to publish; corpus/word/ holds the
# synthetic, Word-authored fixtures that ARE committed.
corpus/*.docx
corpus/*.doc
