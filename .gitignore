# Node
node_modules/
# This is a pnpm workspace (pnpm-workspace.yaml; root scripts use `pnpm -r`).
# An npm/yarn lockfile here would pin a second, conflicting dependency graph.
package-lock.json
yarn.lock
dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Rust
target/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Generated code (checked in but must be regenerated with gen:check)
*.gen.*

# Build state -- durable CAS blobs + sqlite cache index (PUBLISHER_CAS_ROOT),
# and the test harness's own CAS. Content-addressed build output, not source;
# regenerates on the next build.
.publisher/
.test-cas-cache/
.cas-cache/
