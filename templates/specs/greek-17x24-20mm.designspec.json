  "fonts": [
    {
      "family": "Noto Serif",
      "style": "regular",
      "source": "bundled_ofl"
    },
    {
      "family": "Noto Serif",
      "style": "italic",
      "source": "bundled_ofl"
    },
    {
      "family": "Noto Serif",
      "style": "bold",
      "source": "bundled_ofl"
    },
    {
      "family": "Noto Sans",
      "style": "regular",
      "source": "bundled_ofl"
    },
    {
      "family": "Noto Sans",
      "style": "bold",
      "source": "bundled_ofl"
    }
  ],
  "colors": {
    "text": "#000000",
    "paper": "#FFFFFF"
  },
  "templateId": "greek-17x24-noto",
  "hyphenation": {
    "language": "el",
    "zone": 26.0,
    "shortestWord": 8,
    "consecutiveHyphens": 3
  },
