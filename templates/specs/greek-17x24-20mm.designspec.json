{
  "schema": "designspec/1",
  "name": "Greek 17x24 -- Noto, 25mm inner",
  "preferredEngine": "chrome-pagedjs",
  "trimSize": {
    "width": 170.0,
    "height": 240.0,
    "unit": "mm"
  },
  "typography": {
    "bodyFont": {
      "family": "Noto Serif"
    },
    "headingFont": {
      "family": "Noto Sans"
    },
    "bodySize": 10.5,
    "leading": 14.173,
    "scaleRatio": 1.25,
    "measure": 66,
    "bodyAlignment": "justified",
    "paragraphIndent": 1.5,
    "opticalMargins": true,
    "footnoteSize": 8.5
  },
  "grid": {
    "type": "single",
    "baselineIncrement": 14.173
  },
  "margins": {
    "top": 20,
    "bottom": 20,
    "inside": 25,
    "outside": 20,
    "gutter": 0
  },
  "folio": {
    "position": "bottom-center",
    "style": "arabic",
    "suppressOn": [],
    "startNumber": 1
  },
  "runningHeads": {
