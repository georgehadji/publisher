# Publisher API -- ARCHITECTURE_REMEDIATION.md A1.5.
# E3.5: pinned by digest (see Dockerfile.worker's base-image comment for why);
# both stages use the same digest, recorded from the same `docker inspect
# --format='{{index .RepoDigests 0}}'` pull.
FROM node:22-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS build
WORKDIR /app
# packages/api/tsconfig.json extends the monorepo root tsconfig -- the image
# must keep that same relative layout (repo-root/packages/api/), not flatten
# packages/api's contents into /app, or "../../tsconfig.json" resolves to
# nothing.
COPY tsconfig.json ./tsconfig.json
COPY packages/api/package.json ./packages/api/package.json
RUN cd packages/api && npm install
COPY packages/api/ ./packages/api/
RUN cd packages/api && npm run build

FROM node:22-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
WORKDIR /app
# E4.1: dist/node_modules keep the same repo-relative layout as local dev
# (repo-root/packages/api/dist, .../node_modules), not flattened to /app/dist.
# migrate.ts (compiled to dist/migrate.js) resolves the migrations directory
# three levels up from its OWN file -- exactly what a local
# `node packages/api/dist/migrate.js` run from the repo root sees.
# Flattening would put dist one level too shallow and break that resolution.
COPY --from=build /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=build /app/packages/api/dist ./packages/api/dist
COPY packages/api/package.json ./packages/api/package.json
COPY platform/db/migrations ./platform/db/migrations
EXPOSE 4000
CMD ["node", "packages/api/dist/index.js"]
