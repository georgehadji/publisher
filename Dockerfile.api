# Publisher API -- ARCHITECTURE_REMEDIATION.md A1.5.
FROM node:22-slim AS build
WORKDIR /app
# packages/api/tsconfig.json extends the monorepo root tsconfig -- the image
# must keep that same relative layout (repo-root/packages/api/), not flatten
# packages/api's contents into /app, or "../../tsconfig.json" resolves to
# nothing.
COPY tsconfig.json ./tsconfig.json
COPY packages/api/package.json ./packages/api/package.json
RUN cd packages/api && npm install
COPY packages/api/ ./packages/api/
RUN cd packages/api && npm run build

FROM node:22-slim
WORKDIR /app
COPY --from=build /app/packages/api/node_modules ./node_modules
COPY --from=build /app/packages/api/dist ./dist
COPY packages/api/package.json ./
EXPOSE 4000
CMD ["node", "dist/index.js"]
