# Publisher worker -- ARCHITECTURE_REMEDIATION.md A1.4/A1.5.
FROM python:3.12-slim

# weasyprint's real runtime deps (Cairo/Pango stack). The worker runs with
# allow_stub_engines=False (worker.py) -- a missing render engine must fail
# a real build loudly, not silently certify stub output as passed. These
# packages are why it fails loudly for the right reason (a genuine render
# error) instead of the wrong one (ImportError).
# ghostscript is what turns paginate's raw PDF into a real PDF/X-1a press file
# (publisher_prepress.ghostscript). Without it the finish stage refuses to run
# rather than certify an unconverted PDF -- so this package is load-bearing for
# any build reaching completion, not an optional extra.
#
# libreoffice-writer is the converter of record for legacy binary .doc uploads
# (stages/ingest_stage.py `_convert_legacy_doc`). It is the single largest
# thing in this image (~400 MB); it is here because "publish from .doc" is a
# supported entry point and no pure-Python library can read OLE2 Word.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    libffi-dev shared-mime-info fonts-liberation \
    ghostscript \
    libreoffice-writer \
    curl xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The Typst render path (PUBLISHER_RENDER_ENGINE=typst): pandoc converts the
# verified HTML to Typst markup, typst paginates it. Both are pinned by
# version -- Debian's pandoc is 2.17, which predates the Typst writer entirely,
# so the distro package cannot serve this path.
ARG PANDOC_VERSION=3.5
ARG TYPST_VERSION=0.13.1
RUN curl -fsSL -o /tmp/pandoc.deb \
      "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb" \
    && dpkg -i /tmp/pandoc.deb && rm /tmp/pandoc.deb \
    && curl -fsSL -o /tmp/typst.tar.xz \
      "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
    && tar -xJf /tmp/typst.tar.xz -C /tmp \
    && install -m 0755 /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && rm -rf /tmp/typst.tar.xz /tmp/typst-x86_64-unknown-linux-musl \
    # Assert the capability, not the version string: a pandoc without a Typst
    # writer would otherwise fail per-build, at render time, on every book.
    && pandoc --list-output-formats | grep -qx typst \
    && typst --version
# TODO(repro): ARCHITECTURE.md §2.1 principle 7 wants these pinned by digest,
# not version tag. Add `sha256sum -c` once the release hashes are recorded in
# the toolchain manifest alongside the ICC and font hashes.

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY platform/ platform/
COPY services/ services/
COPY stages/ stages/
COPY schemas/ schemas/
COPY profiles/ profiles/
COPY templates/ templates/
COPY corpus/ corpus/
COPY tracer_bullet.py worker.py cli.py ./

ENV PYTHONPATH=/app/platform/stages/py:/app/platform/cas/py:/app/platform/cache/py:/app/platform/reproducibility/src:/app/platform/supply-chain/src:/app/services/structure:/app/services/agents:/app/services/ingest:/app/services/cover:/app/services/epub:/app/services/idml:/app/services/onix:/app/services/prepress:/app/services/alttext

CMD ["python", "worker.py"]
