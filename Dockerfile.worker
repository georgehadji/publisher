# Publisher worker -- ARCHITECTURE_REMEDIATION.md A1.4/A1.5.
# E3.5: pinned by digest, not the `3.12-slim` tag -- a tag is mutable (upstream
# can repoint it to a different image without notice); a digest is the image's
# own content hash, so "the same commit rebuilds to the same base" is actually
# true. Recorded by pulling the tag and reading `docker inspect
# --format='{{index .RepoDigests 0}}'` at pin time; bump deliberately, not
# silently, when a base-image update is wanted.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# weasyprint's real runtime deps (Cairo/Pango stack). The worker runs with
# allow_stub_engines=False (worker.py) -- a missing render engine must fail
# a real build loudly, not silently certify stub output as passed. These
# packages are why it fails loudly for the right reason (a genuine render
# error) instead of the wrong one (ImportError).
# ghostscript is what turns paginate's raw PDF into a real PDF/X-1a press file
# (publisher_prepress.ghostscript). Without it the finish stage refuses to run
# rather than certify an unconverted PDF -- so this package is load-bearing for
# any build reaching completion, not an optional extra.
#
# libreoffice-writer is the converter of record for legacy binary .doc uploads
# (stages/ingest_stage.py `_convert_legacy_doc`). It is the single largest
# thing in this image (~400 MB); it is here because "publish from .doc" is a
# supported entry point and no pure-Python library can read OLE2 Word.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    libffi-dev shared-mime-info fonts-liberation \
    ghostscript \
    libreoffice-writer \
    curl xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The Typst render path (PUBLISHER_RENDER_ENGINE=typst): pandoc converts the
# verified HTML to Typst markup, typst paginates it. Both are pinned by
# version -- Debian's pandoc is 2.17, which predates the Typst writer entirely,
# so the distro package cannot serve this path.
#
# E3.5: pinned by sha256 digest, not just version -- a version tag names a
# GitHub release, not fixed bytes; a compromised release asset (or a CDN
# serving something else for the same URL) would install silently. The
# digests below were recorded by downloading each asset once and running
# `sha256sum` (ARCHITECTURE.md §2.1 principle 7's TODO, now closed) -- neither
# project publishes a signed checksums file for these particular assets, so
# this is trust-on-first-use: a byte-identical re-download always matches,
# and any future change to either URL's content is exactly what `sha256sum -c`
# exists to catch.
ARG PANDOC_VERSION=3.5
ARG PANDOC_DEB_SHA256=4f41d817d262ef3d17953a3e6e0fefddb971aa4f2f121544a9a86db449d945e1
ARG TYPST_VERSION=0.13.1
ARG TYPST_TARBALL_SHA256=7d214bfeffc2e585dc422d1a09d2b144969421281e8c7f5d784b65fc69b5673f
RUN curl -fsSL -o /tmp/pandoc.deb \
      "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb" \
    && echo "${PANDOC_DEB_SHA256}  /tmp/pandoc.deb" | sha256sum -c - \
    && dpkg -i /tmp/pandoc.deb && rm /tmp/pandoc.deb \
    && curl -fsSL -o /tmp/typst.tar.xz \
      "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
    && echo "${TYPST_TARBALL_SHA256}  /tmp/typst.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/typst.tar.xz -C /tmp \
    && install -m 0755 /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && rm -rf /tmp/typst.tar.xz /tmp/typst-x86_64-unknown-linux-musl \
    # Assert the capability, not the version string: a pandoc without a Typst
    # writer would otherwise fail per-build, at render time, on every book.
    && pandoc --list-output-formats | grep -qx typst \
    && typst --version

WORKDIR /app

# E3.5: requirements.lock is the full hash-pinned closure (requirements.txt
# plus every transitive dependency) -- see its own header for how to
# regenerate it. `--require-hashes` refuses to install anything not listed
# here, or whose downloaded bytes don't match the recorded digest.
COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

COPY platform/ platform/
COPY services/ services/
COPY stages/ stages/
COPY schemas/ schemas/
COPY profiles/ profiles/
COPY templates/ templates/
COPY corpus/ corpus/
COPY tracer_bullet.py worker.py cli.py ./

# E3.1 audit: publisher_exec (E1.1) and publisher_sandbox (E3.2) were both
# missing here -- worker.py's own `from publisher_exec import DagExecutor`
# means this container has never actually been able to run a build. The
# reproducibility/supply-chain entries pointed at a `/src` subdirectory
# neither package has (the actual packages sit directly under their
# platform/<name>/ directory, matching every other platform/* package here);
# fixed alongside since they were wrong for the same reason -- a path that
# was never exercised because nothing in worker.py's own import chain needs
# either package.
ENV PYTHONPATH=/app/platform/stages/py:/app/platform/cas/py:/app/platform/cache/py:/app/platform/exec/py:/app/platform/sandbox/py:/app/platform/reproducibility:/app/platform/supply-chain:/app/services/structure:/app/services/agents:/app/services/ingest:/app/services/cover:/app/services/epub:/app/services/idml:/app/services/onix:/app/services/prepress:/app/services/alttext

# E2.2/E3.2 interaction found and reproduced empirically while verifying E3.1
# against a real build in this container: publisher_exec's deadline_mw runs
# every stage on a background thread (its watchdog), and memory_mw applies
# the stage's declared memory_budget_mb as an RLIMIT_AS around it. glibc's
# malloc gives each thread its OWN arena the first time it allocates, and
# reserves that arena's virtual memory (tens of MB) via mmap upfront -- which
# is exactly the kind of allocation RLIMIT_AS exists to block. Under a
# realistic budget (ingest's declared 128 MB, with this image's normal
# baseline footprint already close to it), the watchdog thread's first
# malloc for its own arena can itself fail, and libxml2 does not always
# surface that cleanly -- it appeared here as a real DOCX failing to parse
# with lxml's `unknown error (<string>, line 0)`, not a clean MemoryError.
# MALLOC_ARENA_MAX=1 forces every thread to share one arena, which is the
# standard fix for RLIMIT_AS + multithreaded glibc and was confirmed (with
# and without) to be the difference between the failure and a clean run.
ENV MALLOC_ARENA_MAX=1

# E3.1: run as a fixed non-root uid, never root. Two things the READ-ONLY
# rootfs (docker-compose.yml) makes load-bearing here, both done as root
# before dropping privileges:
#   - fontconfig's cache: weasyprint/LibreOffice both need it, and a
#     read-only rootfs can never build it at runtime.
#   - /data/cas ownership: an empty NAMED VOLUME is created owned by root on
#     first use, but Docker seeds a fresh volume from whatever the image
#     already has at that mount point -- so the image must own it as the
#     app user *before* docker-compose.yml ever mounts cas-data there.
RUN groupadd -r publisher && useradd -r -g publisher -u 10001 -m -d /home/publisher publisher \
    && fc-cache -f \
    && mkdir -p /data/cas && chown -R publisher:publisher /data/cas /home/publisher

USER 10001:10001

CMD ["python", "worker.py"]
